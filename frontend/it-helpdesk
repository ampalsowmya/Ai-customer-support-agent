<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>IT Help Desk | Support Console</title>
<style>
:root{font-family:Inter,Segoe UI,Arial,sans-serif;color:#edf2ff;background:#0b1020}*{box-sizing:border-box}body{margin:0}header{padding:24px 5%;border-bottom:1px solid #26324c;background:#10182b;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}h1{margin:0;font-size:25px}header p{margin:7px 0 0;color:#a8b5d0}.wrap{max-width:1200px;margin:26px auto;padding:0 20px}.grid{display:grid;grid-template-columns:1fr 1.2fr;gap:18px}.panel,.metric{background:#141e34;border:1px solid #293754;border-radius:14px;padding:20px}.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:18px}.metric span{display:block;color:#a8b5d0;font-size:12px}.metric strong{display:block;font-size:27px;margin-top:8px}.panel h2{margin:0 0 16px;font-size:18px}label{display:block;font-size:13px;color:#bdc9df;margin:12px 0 6px}input,textarea,select{width:100%;padding:11px;border:1px solid #344562;border-radius:8px;background:#0d1527;color:#edf2ff;font:inherit}textarea{min-height:90px;resize:vertical}button{background:#48d6d1;color:#06141d;border:0;border-radius:8px;padding:10px 14px;font-weight:700;cursor:pointer}button.secondary{background:#263754;color:#edf2ff}button:disabled{opacity:.5;cursor:wait}.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.row select{max-width:180px}.ticket{border:1px solid #2a3956;border-radius:10px;padding:13px;margin:10px 0;background:#10192c}.ticket h3{font-size:15px;margin:0 0 7px}.muted{color:#9aabc8;font-size:12px}.pill{display:inline-block;border-radius:20px;padding:4px 8px;font-size:11px;background:#263754;margin:2px}.critical,.high{background:#632e3d;color:#ffdbe2}.medium{background:#594925;color:#ffe7a3}.low{background:#1c4d49;color:#b8fff4}.sla{color:#ffb5bd}.message{margin:10px 0;font-size:13px;color:#ffcd88;min-height:18px}.kbitem{border-top:1px solid #293754;padding:12px 0}.kbitem strong{display:block}.kbitem li{color:#bdc9df;margin:5px 0;font-size:13px}@media(max-width:850px){.grid{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}
</style></head>
<body>
<header><div><h1>IT Help Desk</h1><p>Incident management · Troubleshooting · SLA tracking</p></div><div class="row"><button class="secondary" id="refresh">Refresh data</button><span id="apiStatus" class="muted">Connecting…</span></div></header>
<main class="wrap"><section class="metrics" id="metrics"></section><div class="grid">
<section class="panel"><h2>Create incident ticket</h2><form id="ticketForm"><label for="title">Incident title</label><input id="title" required minlength="3" maxlength="160" placeholder="e.g. Unable to access internal website"><label for="description">Description</label><textarea id="description" required minlength="5" maxlength="5000" placeholder="Describe the error, impact, and troubleshooting already attempted"></textarea><label for="requester">Requester</label><input id="requester" value="demo.user" required><div class="row"><div style="flex:1"><label for="priority">Priority</label><select id="priority"><option value="">Auto-suggest</option><option>low</option><option>medium</option><option>high</option><option>critical</option></select></div><div style="flex:1"><label for="assigned">Assigned to</label><input id="assigned" placeholder="Optional"></div></div><div class="message" id="formMessage" role="status"></div><button id="submitBtn" type="submit">Create ticket</button></form><p class="muted">Demo SLA targets: Low 72h · Medium 24h · High 8h · Critical 2h. Replace with the actual organization's policy if known.</p></section>
<section class="panel"><div class="row" style="justify-content:space-between"><h2>Incident queue</h2><div class="row"><select id="statusFilter"><option value="">All statuses</option><option value="open">Open</option><option value="in_progress">In progress</option><option value="escalated">Escalated</option><option value="resolved">Resolved</option></select><select id="priorityFilter"><option value="">All priorities</option><option>critical</option><option>high</option><option>medium</option><option>low</option></select></div></div><div id="tickets"><p class="muted">Loading tickets…</p></div></section>
<section class="panel" style="grid-column:1/-1"><h2>Troubleshooting knowledge base</h2><label for="kbSearch">Search common fixes</label><input id="kbSearch" placeholder="Search login, DNS, network, malware, Windows…"><div id="knowledge"></div></section>
</div></main>
<script>
const API = `${location.protocol}//${location.hostname}:8000`; // API server defaults to port 8000.
const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function request(path,options={}){const r=await fetch(API+path,{headers:{'Content-Type':'application/json',...(options.headers||{})},...options});if(!r.ok){let msg=`Request failed (${r.status})`;try{const d=await r.json();msg=d.detail||msg}catch{}throw new Error(msg)}return r.json()}
function metric(label,value){return `<div class="metric"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`}
async function loadDashboard(){try{const d=await request('/helpdesk/dashboard');$('metrics').innerHTML=[metric('Total tickets',d.total),metric('Open',d.open),metric('In progress',d.in_progress),metric('Escalated',d.escalated),metric('SLA breached',d.sla_breached)].join('');$('apiStatus').textContent='API connected'}catch(e){$('apiStatus').textContent='API unavailable';$('metrics').innerHTML=metric('API status','Offline');$('formMessage').textContent=`Cannot reach ${API}. Start the FastAPI server first.`}}
async function loadTickets(){try{const q=new URLSearchParams();if($('statusFilter').value)q.set('status',$('statusFilter').value);if($('priorityFilter').value)q.set('priority',$('priorityFilter').value);const data=await request('/helpdesk/tickets?'+q.toString());$('tickets').innerHTML=data.length?data.map(t=>`<article class="ticket"><h3>#${t.id} · ${esc(t.title)}</h3><p>${esc(t.description)}</p><div><span class="pill ${esc(t.priority)}">${esc(t.priority.toUpperCase())}</span><span class="pill">${esc(t.category)}</span><span class="pill">${esc(t.status.replace('_',' '))}</span>${t.sla_breached?'<span class="pill sla">SLA BREACHED</span>':''}</div><p class="muted">Requester: ${esc(t.requester)} · Assigned: ${esc(t.assigned_to||'Unassigned')} · Due: ${new Date(t.due_at).toLocaleString()}</p><div class="row"><select id="status-${t.id}"><option value="open" ${t.status==='open'?'selected':''}>Open</option><option value="in_progress" ${t.status==='in_progress'?'selected':''}>In progress</option><option value="escalated" ${t.status==='escalated'?'selected':''}>Escalated</option><option value="resolved" ${t.status==='resolved'?'selected':''}>Resolved</option></select><button class="secondary" onclick="updateTicket(${t.id})">Update status</button></div></article>`).join(''):'<p class="muted">No tickets match these filters.</p>'}catch(e){$('tickets').innerHTML=`<p class="message">${esc(e.message)}. Ensure the API is running.</p>`}}
window.updateTicket=async id=>{try{await request(`/helpdesk/tickets/${id}`,{method:'PATCH',body:JSON.stringify({status:$(`status-${id}`).value})});await refreshAll()}catch(e){alert(e.message)}};
async function loadKnowledge(){try{const q=encodeURIComponent($('kbSearch').value.trim());const data=await request('/helpdesk/knowledge-base'+(q?'?q='+q:''));$('knowledge').innerHTML=data.length?data.map(a=>`<div class="kbitem"><strong>${esc(a.id)} · ${esc(a.title)}</strong><span class="muted">Category: ${esc(a.category)}</span><ol>${a.steps.map(s=>`<li>${esc(s)}</li>`).join('')}</ol></div>`).join(''):'<p class="muted">No matching articles.</p>'}catch(e){$('knowledge').innerHTML=`<p class="message">${esc(e.message)}</p>`}}
async function refreshAll(){await loadDashboard();await Promise.all([loadTickets(),loadKnowledge()])}
$('ticketForm').addEventListener('submit',async e=>{e.preventDefault();$('submitBtn').disabled=true;$('formMessage').textContent='Creating ticket…';try{const body={title:$('title').value,description:$('description').value,requester:$('requester').value,priority:$('priority').value||null,assigned_to:$('assigned').value||null};const t=await request('/helpdesk/tickets',{method:'POST',body:JSON.stringify(body)});$('formMessage').textContent=`Created ticket #${t.id} · ${t.category} · ${t.priority} priority`;e.target.reset();$('requester').value='demo.user';await refreshAll()}catch(err){$('formMessage').textContent=err.message}finally{$('submitBtn').disabled=false}});
$('refresh').addEventListener('click',refreshAll);$('statusFilter').addEventListener('change',loadTickets);$('priorityFilter').addEventListener('change',loadTickets);$('kbSearch').addEventListener('input',loadKnowledge);refreshAll();
</script></body></html>
